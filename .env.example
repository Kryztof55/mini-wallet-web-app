# Copy to .env.local and adjust. Defaults and meaning: specs/02-technical/TS-00-architecture.md §8

# Runtime environment: development | test | production.
# Mock controls are always off when APP_ENV=production, whatever MOCK_CONTROLS_ENABLED says.
APP_ENV=development

# Required: HMAC key for the session cookie (ADR-004). Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Origin used by the CSRF origin check (ADR-004)
APP_ORIGIN=http://localhost:3000

# Mock controls: x-mock-outcome header, POST /api/mock/reset, demo code hint.
# Ignored (forced off) when APP_ENV=production.
MOCK_CONTROLS_ENABLED=true

# One-time code (ASM-15)
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SEC=30

# Confirmation timing (ASM-17)
NEXT_PUBLIC_TRANSFER_SLOW_MS=3000
NEXT_PUBLIC_TRANSFER_TIMEOUT_MS=10000
NEXT_PUBLIC_TRANSFER_STATUS_CHECK_DELAYS_MS=2000,4000,8000

# Outcome distribution when not forced (ASM-16)
OUTCOME_WEIGHTS=success:60,network_error:10,insufficient_funds:10,timeout:10,unknown_error:10

# Simulated latency range for mock repositories, in ms
MOCK_LATENCY_MS=300-900

# Recent activity size (ASM-10)
ACTIVITY_LIMIT=10

# Logging (ADR-006)
LOG_LEVEL=info
